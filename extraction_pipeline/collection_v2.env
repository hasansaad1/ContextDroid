# Collection v2 reference corpus — overnight-ready defaults (Step 9 preflight).
# Source before run_bulk_llm_manifest_resumable.sh or run_collection_v2_preflight.sh.

export CONTEXTDROID_COLLECTION_CONFIG="collection_v2"

# Benign AVD (renamed from malware_sandbox — see SAFETY.md).
export AVD_NAME="${AVD_NAME:-abrg_benign}"

# Step 8 — multi-session per app (2 identical + 1 varied for ABRG E4 deviation floor + coverage).
export SESSIONS_PER_APP="${SESSIONS_PER_APP:-3}"
export SESSION_MODE_SCHEDULE="${SESSION_MODE_SCHEDULE:-identical,identical,varied}"

# Step 9 — v3 hooks, host Frida (no Docker hang).
export FRIDA_USE_DOCKER="${FRIDA_USE_DOCKER:-0}"

# Step 9 — validated execute path.
export CONTEXTDROID_LLM_EXECUTE_ENGINE_ONLY="${CONTEXTDROID_LLM_EXECUTE_ENGINE_ONLY:-0}"

# Item 4 — explore budget floor: Mensa needs ~11 functional taps (~8–10s/tap → ≥110s explore).
# At 600s session length, ratio 0.35 yields 210s; floor guarantees ≥120s even if reserve math tightens.
export CONTEXTDROID_LLM_EXPLORE_UNTIL_SEC_FLOOR="${CONTEXTDROID_LLM_EXPLORE_UNTIL_SEC_FLOOR:-120}"
export CONTEXTDROID_LLM_EXPLORE_RATIO="${CONTEXTDROID_LLM_EXPLORE_RATIO:-0.35}"

# Infra hardening — unattended batch survival.
export BULK_EMULATOR_WATCHDOG="${BULK_EMULATOR_WATCHDOG:-1}"
export BULK_EMULATOR_REBOOT_EVERY_N="${BULK_EMULATOR_REBOOT_EVERY_N:-5}"
export FRIDA_EVENTS_STALE_SEC="${FRIDA_EVENTS_STALE_SEC:-30}"
export FRIDA_ATTACH_GRACE_SEC="${FRIDA_ATTACH_GRACE_SEC:-30}"
export CONTEXTDROID_ROOT_CAPTURE_DEADLINE_SEC="${CONTEXTDROID_ROOT_CAPTURE_DEADLINE_SEC:-30}"

# Log root for v2 corpus (override per run).
export CONTEXTDROID_RUN_LOG_DIR="${CONTEXTDROID_RUN_LOG_DIR:-logs/bulk_llm_benign_v2}"
